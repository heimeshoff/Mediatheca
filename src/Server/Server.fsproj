<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <!-- Docker publishes this project directly (no -r, no SelfContained) and
         must keep working framework-dependent, unchanged. The Desktop shell
         (src/Desktop/Desktop.fsproj) project-references this project and
         publishes self-contained for a RID — MSBuild's NETSDK1150 check
         requires a self-contained exe's project references to also resolve
         as self-contained once a RuntimeIdentifier is flowing through, so
         this only turns on when one is present (i.e. never for the plain
         Docker publish). -->
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <RuntimeIdentifiers>win-x64;osx-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="DataDir.fs" />
    <Compile Include="EventStore.fs" />
    <Compile Include="Projection.fs" />
    <Compile Include="Movies.fs" />
    <Compile Include="Friends.fs" />
    <Compile Include="Series.fs" />
    <Compile Include="Games.fs" />
    <Compile Include="FacetDerivation.fs" />
    <Compile Include="ReleaseDateParsing.fs" />
    <Compile Include="Tmdb.fs" />
    <Compile Include="Rawg.fs" />
    <Compile Include="Steam.fs" />
    <Compile Include="HowLongToBeat.fs" />
    <Compile Include="Jellyfin.fs" />
    <Compile Include="JellyfinImport.fs" />
    <Compile Include="ImageStore.fs" />
    <Compile Include="CastStore.fs" />
    <Compile Include="SettingsStore.fs" />
    <Compile Include="JellyfinStore.fs" />
    <Compile Include="MetadataCache.fs" />
    <Compile Include="ContentBlocks.fs" />
    <Compile Include="ContentBlockProjection.fs" />
    <Compile Include="GameJournal.fs" />
    <Compile Include="Catalogs.fs" />
    <Compile Include="CatalogProjection.fs" />
    <Compile Include="MovieProjection.fs" />
    <Compile Include="FriendProjection.fs" />
    <Compile Include="SeriesProjection.fs" />
    <Compile Include="GameProjection.fs" />
    <Compile Include="PlaySessionProjection.fs" />
    <Compile Include="PlaytimeTracker.fs" />
    <Compile Include="GameFacetBackfill.fs" />
    <Compile Include="GameDeckCompatBackfill.fs" />
    <Compile Include="GameReleaseDateBackfill.fs" />
    <Compile Include="SeriesRefresh.fs" />
    <Compile Include="ScheduledJobs.fs" />
    <Compile Include="JellyfinSync.fs" />
    <Compile Include="EventFormatting.fs" />
    <Compile Include="Sse.fs" />
    <Compile Include="EventLogFilter.fs" />
    <!-- Administration.fs must compile before CinemarcoImport.fs
         (administration-kv7dp, ADR-0043): CinemarcoImport's post-import
         rebuild loop calls Administration.lossyRebuildRejectionMessage.
         CinemarcoImport.fs must in turn stay before Api.fs, which calls
         CinemarcoImport.runImport. Neither Administration.fs nor Api.fs
         depends on the other. -->
    <Compile Include="Administration.fs" />
    <Compile Include="StartupCutover.fs" />
    <Compile Include="CinemarcoImport.fs" />
    <Compile Include="Api.fs" />
    <Compile Include="Composition.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\Shared.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Giraffe" Version="7.*" />
    <PackageReference Include="Fable.Remoting.Giraffe" Version="5.*" />
    <PackageReference Include="Donald" Version="10.*" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.*" />
    <PackageReference Include="Thoth.Json.Net" Version="12.*" />
  </ItemGroup>

</Project>
